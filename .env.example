# Session pepper (HMAC for session token hashes). Required in production.
AUTH_SECRET=solderlab-dev-secret-change-me

# Groq LLM for Impact claims and the project Assistant chat (checks/merge stay deterministic)
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# DATABASE_URL=file:./data/solderlab.json
# SQLite file is data/solderlab.sqlite (WAL). JSON is only used for one-shot migration.
# SOLDERLAB_DATABASE_URL=file:./data/solderlab.json

# Parser corpus (CI sets CI=1). Local oracle needs KiCad.
# KICAD_CLI=
# CORPUS_REQUIRED=
# CORPUS_REQUIRE_KICAD=

# Hidden surfaces (unset = 404, not in nav)
# FEATURE_LIBRARY=
# FEATURE_WEBHOOKS=
# DEBUG_IMPACT=

# Part obsolescence / supply (nexar | manual)
# PART_DATA_PROVIDER=nexar
# PART_DATA_API_KEY=
# PART_DATA_BASE_URL=
